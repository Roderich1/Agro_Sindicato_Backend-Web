NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrochemical_inventory?schema=public"
JWT_SECRET="change-me-in-development"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-with-a-very-long-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
# Sync v1 (F05). Generate a key with `openssl rand -base64 32`; never commit a real one.
SYNC_V1_FINGERPRINT_KEY=""
SYNC_V1_FINGERPRINT_KEY_VERSION="1"
SYNC_V1_FINGERPRINT_PREVIOUS_KEYS=""
SYNC_V1_PRODUCTION_ADMISSION="disabled"
# F08 private backups (development disk adapter). Empty = routes answer 503.
BACKUP_STORAGE_DIR=
BACKUP_MAX_BYTES=104857600
BACKUP_MAX_ACTIVE_PER_MEMBER=5
