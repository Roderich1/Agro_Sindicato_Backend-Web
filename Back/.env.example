NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrochemical_inventory?schema=public"
JWT_SECRET="change-me-in-development"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-with-a-very-long-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
# Sync v1 (F05). Generate a key with `openssl rand -base64 32`; never commit a real one.
SYNC_V1_FINGERPRINT_KEY=""
SYNC_V1_FINGERPRINT_KEY_VERSION="1"
SYNC_V1_FINGERPRINT_PREVIOUS_KEYS=""
SYNC_V1_PRODUCTION_ADMISSION="disabled"
# F08 private backups (development disk adapter). Empty = routes answer 503.
BACKUP_STORAGE_DIR=
BACKUP_MAX_BYTES=104857600
BACKUP_MAX_ACTIVE_PER_MEMBER=5
# With NODE_ENV=production the routes answer 503 unless this is `enabled`.
BACKUP_PRODUCTION_ADMISSION=disabled
# Deadline of one upload in ms (default 1800000 = 30 min; must be < 3600000).
BACKUP_UPLOAD_DEADLINE_MS=
# F08-BKP-07: empty or `disk` = BACKUP_STORAGE_DIR; `b2` = Backblaze B2 by its
# S3 API with the variables below (never the disk; incomplete = 503). Never
# write the key values here: export them from the encrypted store.
BACKUP_STORAGE_PROVIDER=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# One segment ending in "/", e.g. ensayo-f08/ for synthetic trials.
BACKUP_S3_PREFIX=
# #81 PHASE 6: legacy private writes stay closed (403 LEGACY_ROUTE_CLOSED).
# "enabled" is an operational rollback of this server only, never the normal path.
LEGACY_PRIVATE_WRITES_ROLLBACK=
