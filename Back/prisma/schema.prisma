generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AGRICULTOR
  DIRECTIVA
  ADMINISTRADOR
}

enum StockMovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

enum StockMovementReasonType {
  COMPRA
  ENTRADA_SIMPLE
  APLICACION
  PERDIDA_DERRAME
  VENCIMIENTO
  PRESTAMO_ENTREGA
  DEVOLUCION
  AJUSTE
  OTRO
}

enum CampaignStatus {
  PLANIFICADA
  ABIERTA
  CERRADA
  CANCELADA
}

enum PlotStatus {
  ACTIVA
  INACTIVA
}

enum CropAssignmentStatus {
  PLANIFICADO
  ACTIVO
  CAMBIADO
  CERRADO
}

enum InventoryLotStatus {
  DISPONIBLE
  AGOTADO
  VENCIDO
  BLOQUEADO
}

enum AgrochemicalApplicationStatus {
  REGISTRADA
  ANULADA
}

enum CalendarEventType {
  VENCIMIENTO_LOTE
  PAGO_PROXIMO
  APLICACION
  COMPRA_PROGRAMADA
  STOCK_BAJO
  CIERRE_CAMPANA
}

enum CalendarEventStatus {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum AuditAction {
  CREAR
  ACTUALIZAR
  INACTIVAR
  ELIMINAR
  ABRIR_CAMPANA
  CERRAR_CAMPANA
  AJUSTAR_STOCK
  REGISTRAR_PAGO
  SINCRONIZAR
  OTRO
}

enum PurchaseStatus {
  BORRADOR
  PROGRAMADA
  CONFIRMADA
  RECIBIDA_PARCIAL
  RECIBIDA
  CERRADA
  CANCELADA
}

enum PurchaseType {
  INDIVIDUAL
  CONJUNTA
}

enum PurchasePaymentMode {
  CONTADO
  CREDITO
}

enum PurchaseParticipantStatus {
  PENDIENTE
  CONFIRMADO
  ENTREGADO
  CANCELADO
}

enum PayableStatus {
  PENDIENTE
  PARCIAL
  PAGADA
  VENCIDA
}

enum SyncOperationStatus {
  PENDIENTE
  APLICADA
  CONFLICTO
  RECHAZADA
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  products                 Product[]
  suppliers                Supplier[]
  warehouses               Warehouse[]
  inventoryLots            InventoryLot[]
  stockMovements           StockMovement[]
  purchases                Purchase[]
  purchaseItems            PurchaseItem[]
  purchaseItemAllocations  PurchaseItemAllocation[]
  purchaseParticipants     PurchaseParticipant[]
  payableAccounts          PayableAccount[]
  payments                 Payment[]
  syncOperations           SyncOperation[]
  demandForecasts          DemandForecast[]
  campaigns                AgriculturalCampaign[]
  plots                    Plot[]
  crops                    Crop[]
  plotCropAssignments      PlotCropAssignment[]
  agrochemicalApplications AgrochemicalApplication[]
  calendarEvents           CalendarEvent[]
  auditLogs                AuditLog[]
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(AGRICULTOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant                  Tenant                    @relation(fields: [tenantId], references: [id])
  refreshTokens           RefreshToken[]
  warehouses              Warehouse[]
  inventoryLots           InventoryLot[]
  stockMovements          StockMovement[]           @relation("StockMovementActor")
  ownedStockMovements     StockMovement[]           @relation("StockMovementOwner")
  purchases               Purchase[]
  purchaseItemAllocations PurchaseItemAllocation[]
  purchaseParticipants    PurchaseParticipant[]
  payableAccounts         PayableAccount[]
  payments                Payment[]                 @relation("PaymentRegistrar")
  syncOperations          SyncOperation[]
  createdCampaigns        AgriculturalCampaign[]    @relation("CampaignCreator")
  closedCampaigns         AgriculturalCampaign[]    @relation("CampaignCloser")
  plots                   Plot[]
  plotCropAssignments     PlotCropAssignment[]
  ownedApplications       AgrochemicalApplication[] @relation("AgrochemicalApplicationOwner")
  appliedApplications     AgrochemicalApplication[] @relation("AgrochemicalApplicationAppliedBy")
  calendarEvents          CalendarEvent[]
  auditLogsAsActor        AuditLog[]                @relation("AuditActor")
  auditLogsAsOwner        AuditLog[]                @relation("AuditOwner")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  tenantId  String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Product {
  id                    String   @id @default(uuid())
  tenantId              String
  name                  String
  commercialName        String?
  activeIngredient      String?
  category              String?
  toxicologicalCategory String?
  safetyDataSheetUrl    String?
  safetyDataSheetName   String?
  safetyInstructions    String?
  qrCodeValue           String?
  unit                  String
  minimumStock          Decimal  @default(0)
  currentStock          Decimal  @default(0)
  expirationWarningDays Int      @default(90)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  inventoryLots            InventoryLot[]
  movements                StockMovement[]
  purchaseItems            PurchaseItem[]
  demandForecasts          DemandForecast[]
  agrochemicalApplications AgrochemicalApplication[]

  @@unique([tenantId, name])
  @@unique([tenantId, qrCodeValue])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  purchases Purchase[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model AgriculturalCampaign {
  id               String         @id @default(uuid())
  tenantId         String
  name             String
  status           CampaignStatus @default(PLANIFICADA)
  isActive         Boolean        @default(false)
  startDate        DateTime
  estimatedEndDate DateTime?
  closedAt         DateTime?
  createdById      String?
  closedById       String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  createdBy                User?                     @relation("CampaignCreator", fields: [createdById], references: [id])
  closedBy                 User?                     @relation("CampaignCloser", fields: [closedById], references: [id])
  plotCropAssignments      PlotCropAssignment[]
  inventoryLots            InventoryLot[]
  stockMovements           StockMovement[]
  purchases                Purchase[]
  payableAccounts          PayableAccount[]
  payments                 Payment[]
  syncOperations           SyncOperation[]
  agrochemicalApplications AgrochemicalApplication[]
  calendarEvents           CalendarEvent[]
  auditLogs                AuditLog[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, isActive])
}

model Plot {
  id          String     @id @default(uuid())
  tenantId    String
  ownerUserId String
  name        String
  location    String?
  area        Decimal?
  areaUnit    String     @default("ha")
  status      PlotStatus @default(ACTIVA)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  owner                    User                      @relation(fields: [ownerUserId], references: [id])
  cropAssignments          PlotCropAssignment[]
  stockMovements           StockMovement[]
  agrochemicalApplications AgrochemicalApplication[]

  @@unique([tenantId, ownerUserId, name])
  @@index([tenantId, ownerUserId, status])
}

model Crop {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  variety   String?
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  cropAssignments          PlotCropAssignment[]
  stockMovements           StockMovement[]
  agrochemicalApplications AgrochemicalApplication[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model PlotCropAssignment {
  id          String               @id @default(uuid())
  tenantId    String
  campaignId  String
  plotId      String
  cropId      String
  ownerUserId String
  status      CropAssignmentStatus @default(ACTIVO)
  plantedArea Decimal?
  plantedAt   DateTime?
  changedAt   DateTime?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  campaign                 AgriculturalCampaign      @relation(fields: [campaignId], references: [id])
  plot                     Plot                      @relation(fields: [plotId], references: [id])
  crop                     Crop                      @relation(fields: [cropId], references: [id])
  owner                    User                      @relation(fields: [ownerUserId], references: [id])
  agrochemicalApplications AgrochemicalApplication[]

  @@unique([campaignId, plotId])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, campaignId])
  @@index([plotId, cropId])
}

model Warehouse {
  id          String   @id @default(uuid())
  tenantId    String
  ownerUserId String?
  name        String
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  owner     User?           @relation(fields: [ownerUserId], references: [id])
  lots      InventoryLot[]
  movements StockMovement[]

  @@index([tenantId])
  @@index([ownerUserId])
}

model InventoryLot {
  id              String             @id @default(uuid())
  tenantId        String
  ownerUserId     String
  campaignId      String?
  productId       String
  warehouseId     String?
  purchaseItemId  String?
  lotNumber       String?
  expirationDate  DateTime?
  initialQuantity Decimal
  currentQuantity Decimal
  unitCost        Decimal?
  status          InventoryLotStatus @default(DISPONIBLE)
  qrCodeValue     String?
  receivedAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  owner                    User                      @relation(fields: [ownerUserId], references: [id])
  campaign                 AgriculturalCampaign?     @relation(fields: [campaignId], references: [id])
  product                  Product                   @relation(fields: [productId], references: [id])
  warehouse                Warehouse?                @relation(fields: [warehouseId], references: [id])
  purchaseItem             PurchaseItem?             @relation(fields: [purchaseItemId], references: [id])
  movements                StockMovement[]
  agrochemicalApplications AgrochemicalApplication[]

  @@unique([tenantId, qrCodeValue])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, campaignId])
  @@index([productId])
  @@index([expirationDate])
}

model StockMovement {
  id             String                   @id @default(uuid())
  tenantId       String
  ownerUserId    String
  campaignId     String?
  productId      String
  inventoryLotId String?
  warehouseId    String?
  plotId         String?
  cropId         String?
  applicationId  String?
  userId         String?
  type           StockMovementType
  reasonType     StockMovementReasonType?
  quantity       Decimal
  reason         String?
  occurredAt     DateTime                 @default(now())
  createdAt      DateTime                 @default(now())

  tenant       Tenant                   @relation(fields: [tenantId], references: [id])
  owner        User                     @relation("StockMovementOwner", fields: [ownerUserId], references: [id])
  campaign     AgriculturalCampaign?    @relation(fields: [campaignId], references: [id])
  product      Product                  @relation(fields: [productId], references: [id])
  inventoryLot InventoryLot?            @relation(fields: [inventoryLotId], references: [id])
  warehouse    Warehouse?               @relation(fields: [warehouseId], references: [id])
  plot         Plot?                    @relation(fields: [plotId], references: [id])
  crop         Crop?                    @relation(fields: [cropId], references: [id])
  application  AgrochemicalApplication? @relation(fields: [applicationId], references: [id])
  user         User?                    @relation("StockMovementActor", fields: [userId], references: [id])

  @@index([tenantId, ownerUserId, occurredAt])
  @@index([tenantId, campaignId])
  @@index([productId])
  @@index([inventoryLotId])
  @@index([plotId])
  @@index([applicationId])
}

model AgrochemicalApplication {
  id                   String                        @id @default(uuid())
  tenantId             String
  campaignId           String
  ownerUserId          String
  appliedById          String?
  plotId               String
  cropId               String
  plotCropAssignmentId String?
  productId            String
  inventoryLotId       String?
  quantity             Decimal
  dose                 String?
  targetPest           String?
  weatherConditions    String?
  responsibleName      String?
  notes                String?
  status               AgrochemicalApplicationStatus @default(REGISTRADA)
  appliedAt            DateTime                      @default(now())
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  campaign           AgriculturalCampaign @relation(fields: [campaignId], references: [id])
  owner              User                 @relation("AgrochemicalApplicationOwner", fields: [ownerUserId], references: [id])
  appliedBy          User?                @relation("AgrochemicalApplicationAppliedBy", fields: [appliedById], references: [id])
  plot               Plot                 @relation(fields: [plotId], references: [id])
  crop               Crop                 @relation(fields: [cropId], references: [id])
  plotCropAssignment PlotCropAssignment?  @relation(fields: [plotCropAssignmentId], references: [id])
  product            Product              @relation(fields: [productId], references: [id])
  inventoryLot       InventoryLot?        @relation(fields: [inventoryLotId], references: [id])
  movements          StockMovement[]

  @@index([tenantId, ownerUserId, appliedAt])
  @@index([tenantId, campaignId])
  @@index([plotId, cropId])
  @@index([productId])
  @@index([inventoryLotId])
}

model Purchase {
  id             String              @id @default(uuid())
  tenantId       String
  campaignId     String?
  supplierId     String
  createdById    String?
  type           PurchaseType        @default(INDIVIDUAL)
  paymentMode    PurchasePaymentMode @default(CONTADO)
  status         PurchaseStatus      @default(BORRADOR)
  purchasedAt    DateTime            @default(now())
  expectedAt     DateTime?
  receivedAt     DateTime?
  totalAmount    Decimal             @default(0)
  discountAmount Decimal             @default(0)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  campaign     AgriculturalCampaign? @relation(fields: [campaignId], references: [id])
  supplier     Supplier              @relation(fields: [supplierId], references: [id])
  createdBy    User?                 @relation(fields: [createdById], references: [id])
  items        PurchaseItem[]
  participants PurchaseParticipant[]
  payables     PayableAccount[]

  @@index([tenantId, type, status])
  @@index([tenantId, campaignId])
  @@index([supplierId])
}

model PurchaseItem {
  id             String  @id @default(uuid())
  tenantId       String
  purchaseId     String
  productId      String
  quantity       Decimal
  unitCost       Decimal
  discountAmount Decimal @default(0)
  subtotal       Decimal

  tenant        Tenant                   @relation(fields: [tenantId], references: [id])
  purchase      Purchase                 @relation(fields: [purchaseId], references: [id])
  product       Product                  @relation(fields: [productId], references: [id])
  inventoryLots InventoryLot[]
  allocations   PurchaseItemAllocation[]

  @@index([tenantId, purchaseId])
  @@index([productId])
}

model PurchaseItemAllocation {
  id             String   @id @default(uuid())
  tenantId       String
  purchaseItemId String
  userId         String
  quantity       Decimal
  subtotal       Decimal
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  purchaseItem PurchaseItem @relation(fields: [purchaseItemId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([purchaseItemId, userId])
  @@index([tenantId, userId])
}

model PurchaseParticipant {
  id              String                    @id @default(uuid())
  tenantId        String
  purchaseId      String
  userId          String
  status          PurchaseParticipantStatus @default(PENDIENTE)
  requestedAmount Decimal                   @default(0)
  allocatedAmount Decimal                   @default(0)
  notes           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  purchase Purchase @relation(fields: [purchaseId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([purchaseId, userId])
  @@index([tenantId, userId])
}

model PayableAccount {
  id                String        @id @default(uuid())
  tenantId          String
  campaignId        String?
  purchaseId        String
  responsibleUserId String?
  dueDate           DateTime
  totalAmount       Decimal
  paidAmount        Decimal       @default(0)
  status            PayableStatus @default(PENDIENTE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  campaign        AgriculturalCampaign? @relation(fields: [campaignId], references: [id])
  purchase        Purchase              @relation(fields: [purchaseId], references: [id])
  responsibleUser User?                 @relation(fields: [responsibleUserId], references: [id])
  payments        Payment[]

  @@index([tenantId, status, dueDate])
  @@index([tenantId, campaignId])
  @@index([purchaseId])
  @@index([responsibleUserId])
}

model Payment {
  id               String   @id @default(uuid())
  tenantId         String
  campaignId       String?
  payableAccountId String
  registeredById   String?
  amount           Decimal
  paidAt           DateTime @default(now())
  notes            String?

  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  campaign       AgriculturalCampaign? @relation(fields: [campaignId], references: [id])
  payableAccount PayableAccount        @relation(fields: [payableAccountId], references: [id])
  registeredBy   User?                 @relation("PaymentRegistrar", fields: [registeredById], references: [id])

  @@index([tenantId, paidAt])
  @@index([tenantId, campaignId])
  @@index([payableAccountId])
}

model SyncOperation {
  id           String              @id @default(uuid())
  tenantId     String
  campaignId   String?
  userId       String?
  clientId     String
  entityName   String
  entityId     String?
  operation    String
  payload      Json
  status       SyncOperationStatus @default(PENDIENTE)
  errorMessage String?
  createdAt    DateTime            @default(now())
  appliedAt    DateTime?

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  campaign  AgriculturalCampaign? @relation(fields: [campaignId], references: [id])
  user      User?                 @relation(fields: [userId], references: [id])
  conflicts SyncConflict[]

  @@unique([tenantId, userId, clientId, entityId])
  @@index([tenantId, clientId, status])
  @@index([tenantId, campaignId])
  @@index([entityName, entityId])
}

model CalendarEvent {
  id              String              @id @default(uuid())
  tenantId        String
  campaignId      String?
  ownerUserId     String?
  type            CalendarEventType
  status          CalendarEventStatus @default(PENDIENTE)
  title           String
  description     String?
  eventDate       DateTime
  sourceEntity    String?
  sourceEntityId  String?
  isAutoGenerated Boolean             @default(true)
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  campaign AgriculturalCampaign? @relation(fields: [campaignId], references: [id])
  owner    User?                 @relation(fields: [ownerUserId], references: [id])

  @@index([tenantId, eventDate])
  @@index([tenantId, ownerUserId, eventDate])
  @@index([tenantId, campaignId, type])
  @@index([sourceEntity, sourceEntityId])
}

model AuditLog {
  id          String      @id @default(uuid())
  tenantId    String
  campaignId  String?
  actorUserId String?
  ownerUserId String?
  action      AuditAction
  entityName  String
  entityId    String?
  summary     String?
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  campaign AgriculturalCampaign? @relation(fields: [campaignId], references: [id])
  actor    User?                 @relation("AuditActor", fields: [actorUserId], references: [id])
  owner    User?                 @relation("AuditOwner", fields: [ownerUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, campaignId])
  @@index([tenantId, actorUserId])
  @@index([tenantId, ownerUserId])
  @@index([entityName, entityId])
}

model SyncConflict {
  id              String    @id @default(uuid())
  syncOperationId String
  serverSnapshot  Json
  clientSnapshot  Json
  resolvedPayload Json?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  syncOperation SyncOperation @relation(fields: [syncOperationId], references: [id])
}

model DemandForecast {
  id              String   @id @default(uuid())
  tenantId        String
  productId       String
  campaignName    String
  predictedDemand Decimal
  confidence      Decimal?
  generatedAt     DateTime @default(now())
  metadata        Json?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId, productId, generatedAt])
}
