generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AGRICULTOR
  DIRECTIVA
  ADMINISTRADOR
}

enum StockMovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

enum StockMovementReasonType {
  COMPRA
  ENTRADA_SIMPLE
  APLICACION
  PERDIDA_DERRAME
  VENCIMIENTO
  PRESTAMO_ENTREGA
  DEVOLUCION
  AJUSTE
  OTRO
}

enum CampaignStatus {
  PLANIFICADA
  ABIERTA
  CERRADA
  CANCELADA
}

enum PlotStatus {
  ACTIVA
  INACTIVA
}

enum CropAssignmentStatus {
  PLANIFICADO
  ACTIVO
  CAMBIADO
  CERRADO
}

enum InventoryLotStatus {
  DISPONIBLE
  AGOTADO
  VENCIDO
  BLOQUEADO
}

enum AgrochemicalApplicationStatus {
  REGISTRADA
  ANULADA
}

enum CalendarEventType {
  VENCIMIENTO_LOTE
  PAGO_PROXIMO
  APLICACION
  COMPRA_PROGRAMADA
  STOCK_BAJO
  CIERRE_CAMPANA
}

enum CalendarEventStatus {
  PENDIENTE
  COMPLETADO
  CANCELADO
}

enum AuditAction {
  CREAR
  ACTUALIZAR
  INACTIVAR
  ELIMINAR
  ABRIR_CAMPANA
  CERRAR_CAMPANA
  AJUSTAR_STOCK
  REGISTRAR_PAGO
  SINCRONIZAR
  OTRO
}

enum PurchaseStatus {
  BORRADOR
  PROGRAMADA
  CONFIRMADA
  RECIBIDA_PARCIAL
  RECIBIDA
  CERRADA
  CANCELADA
}

enum PurchaseType {
  INDIVIDUAL
  CONJUNTA
}

enum PurchasePaymentMode {
  CONTADO
  CREDITO
}

enum PurchaseParticipantStatus {
  PENDIENTE
  CONFIRMADO
  ENTREGADO
  CANCELADO
}

enum PayableStatus {
  PENDIENTE
  PARCIAL
  PAGADA
  VENCIDA
}

enum SyncOperationStatus {
  PENDIENTE
  APLICADA
  CONFLICTO
  RECHAZADA
}

enum ClientRegistrationStatus {
  ACTIVE
  REVOKED
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  COMPROMISED
}

enum AuthRefreshTransport {
  COOKIE
  BODY
}

enum SyncV1ProjectionType {
  CONSUMPTION_TOTAL
  DECLARED_NEED
}

enum SyncV1Action {
  PUBLISH
  SUPERSEDE
  CANCEL
}

enum SyncV1ProcessingState {
  PROCESSING
  FINAL
}

enum SyncV1Outcome {
  APPLIED
  CONFLICT
  REJECTED
}

enum SyncV1Disposition {
  RETIRE_FROM_OUTBOX
  KEEP_FOR_RECONCILIATION
  MOVE_TO_TERMINAL_FAILURE
}

enum SyncV1BaseUnit {
  ML
  G
}

enum SyncV1ContributionStatus {
  NEVER_PUBLISHED
  ACTIVE
  CANCELLED
  CONTESTED
}

enum SyncV1DisputeCloseReason {
  RESOLVED
  SUPERSEDED
}

// F08-BKP-01 (#37): lifecycle of a private backup. Only AVAILABLE copies are
// listed or served; a failed or incomplete upload never replaces one.
enum BackupStatus {
  UPLOADING
  AVAILABLE
  FAILED
  DELETED
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  members                  Member[]
  clientRegistrations      ClientRegistration[]
  products                 Product[]
  suppliers                Supplier[]
  warehouses               Warehouse[]
  inventoryLots            InventoryLot[]
  stockMovements           StockMovement[]
  purchases                Purchase[]
  purchaseItems            PurchaseItem[]
  purchaseItemAllocations  PurchaseItemAllocation[]
  purchaseParticipants     PurchaseParticipant[]
  payableAccounts          PayableAccount[]
  payments                 Payment[]
  syncOperations           SyncOperation[]
  demandForecasts          DemandForecast[]
  campaigns                AgriculturalCampaign[]
  plots                    Plot[]
  crops                    Crop[]
  plotCropAssignments      PlotCropAssignment[]
  agrochemicalApplications AgrochemicalApplication[]
  calendarEvents           CalendarEvent[]
  auditLogs                AuditLog[]
  syncV1OperationJournals  SyncV1OperationJournal[]
  syncV1Contributions      SyncV1Contribution[]
  productAssociations      ProductCanonicalAssociation[]
  collectiveReleases       CollectiveRelease[]
  backupMetadata           BackupMetadata[]
  jointPurchaseProposals   JointPurchaseProposal[]
  collectiveSeals          CollectiveSeal[]
  consumptionSeries        ConsumptionSeries[]
  estimationRuns           EstimationRun[]
  comparabilitySeasons     ComparabilitySeason[]
  campaignClassifications  CampaignSeasonClassification[]
  estimationJobs           EstimationJob[]
  identificationRequests   ProductIdentificationRequest[]
  jointPurchaseCalls       JointPurchaseCall[]
  jointParticipations      JointPurchaseParticipation[]
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(AGRICULTOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant                    Tenant                         @relation(fields: [tenantId], references: [id])
  members                   Member[]
  refreshTokens             RefreshToken[]
  warehouses                Warehouse[]
  inventoryLots             InventoryLot[]
  stockMovements            StockMovement[]                @relation("StockMovementActor")
  ownedStockMovements       StockMovement[]                @relation("StockMovementOwner")
  purchases                 Purchase[]
  purchaseItemAllocations   PurchaseItemAllocation[]
  purchaseParticipants      PurchaseParticipant[]
  payableAccounts           PayableAccount[]
  payments                  Payment[]                      @relation("PaymentRegistrar")
  syncOperations            SyncOperation[]
  createdCampaigns          AgriculturalCampaign[]         @relation("CampaignCreator")
  closedCampaigns           AgriculturalCampaign[]         @relation("CampaignCloser")
  plots                     Plot[]
  plotCropAssignments       PlotCropAssignment[]
  ownedApplications         AgrochemicalApplication[]      @relation("AgrochemicalApplicationOwner")
  appliedApplications       AgrochemicalApplication[]      @relation("AgrochemicalApplicationAppliedBy")
  calendarEvents            CalendarEvent[]
  auditLogsAsActor          AuditLog[]                     @relation("AuditActor")
  auditLogsAsOwner          AuditLog[]                     @relation("AuditOwner")
  productAssociationsMade   ProductCanonicalAssociation[]  @relation("ProductAssociationActor")
  productAssociationsClosed ProductCanonicalAssociation[]  @relation("ProductAssociationCloser")
  jointPurchaseProposals    JointPurchaseProposal[]        @relation("JointPurchaseProposalAuthor")
  collectiveSeals           CollectiveSeal[]               @relation("CollectiveSealActor")
  estimationRuns            EstimationRun[]                @relation("EstimationRunRequester")
  estimationJobs            EstimationJob[]                @relation("EstimationJobRequester")
  comparabilitySeasons      ComparabilitySeason[]          @relation("ComparabilitySeasonCreator")
  campaignClassifications   CampaignSeasonClassification[] @relation("CampaignSeasonClassifier")
  identificationsResolved   ProductIdentificationRequest[] @relation("ProductIdentificationResolver")
  identificationNotes       ProductIdentificationRequest[] @relation("ProductIdentificationNoteAuthor")
  identificationEvents      ProductIdentificationEvent[]   @relation("ProductIdentificationEventActor")
  callsAsResponsible        JointPurchaseCall[]            @relation("JointPurchaseCallResponsible")
  callsCreated              JointPurchaseCall[]            @relation("JointPurchaseCallCreator")
  callsOpened               JointPurchaseCall[]            @relation("JointPurchaseCallOpener")
  callsCancelled            JointPurchaseCall[]            @relation("JointPurchaseCallCanceller")
  callAccessGrants          JointPurchaseCallAccess[]      @relation("JointPurchaseCallAccessHolder")
  callAccessGranted         JointPurchaseCallAccess[]      @relation("JointPurchaseCallAccessGrantor")
  callAccessEventsAbout     JointPurchaseCallAccessEvent[] @relation("JointPurchaseCallAccessEventSubject")
  callAccessEventsActed     JointPurchaseCallAccessEvent[] @relation("JointPurchaseCallAccessEventActor")
  callEvents                JointPurchaseCallEvent[]       @relation("JointPurchaseCallEventActor")
  callClosings              JointPurchaseCallClosing[]     @relation("JointPurchaseCallCloser")
}

model Member {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                  Tenant                                @relation(fields: [tenantId], references: [id])
  user                    User                                  @relation(fields: [userId], references: [id])
  clientRegistrations     ClientRegistration[]
  authSessions            AuthSession[]
  syncV1OperationJournals SyncV1OperationJournal[]
  syncV1Contributions     SyncV1Contribution[]
  backupMetadata          BackupMetadata[]
  identificationRequests  ProductIdentificationRequest[]
  jointParticipations     JointPurchaseParticipation[]
  jointOperations         JointPurchaseParticipationOperation[]

  @@unique([tenantId, userId])
  // Referenced by the journal's composite FK: Member must belong to its tenant.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, isActive])
}

model ClientRegistration {
  id           String                   @id @default(uuid())
  tenantId     String
  memberId     String
  clientIdHash String
  status       ClientRegistrationStatus @default(ACTIVE)
  createdAt    DateTime                 @default(now())
  lastSeenAt   DateTime                 @default(now())
  revokedAt    DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  member       Member        @relation(fields: [memberId], references: [id])
  authSessions AuthSession[]

  @@unique([tenantId, memberId, clientIdHash])
  @@index([tenantId, memberId])
  @@index([tenantId, memberId, status])
}

model RefreshToken {
  id              String    @id @default(uuid())
  tokenHash       String    @unique
  userId          String
  tenantId        String
  sessionId       String?
  contractVersion Int       @default(1)
  ipAddress       String?
  userAgent       String?
  expiresAt       DateTime
  consumedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  user    User         @relation(fields: [userId], references: [id])
  session AuthSession? @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([contractVersion, sessionId])
}

model AuthSession {
  id                   String               @id @default(uuid())
  memberId             String
  clientRegistrationId String?
  status               AuthSessionStatus    @default(ACTIVE)
  refreshTransport     AuthRefreshTransport
  createdAt            DateTime             @default(now())
  lastSeenAt           DateTime             @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?
  compromisedAt        DateTime?
  ipAddress            String?
  userAgent            String?

  member             Member              @relation(fields: [memberId], references: [id])
  clientRegistration ClientRegistration? @relation(fields: [clientRegistrationId], references: [id])
  refreshTokens      RefreshToken[]

  @@index([memberId, status])
  @@index([clientRegistrationId, status])
  @@index([expiresAt])
}

model Product {
  id                    String   @id @default(uuid())
  tenantId              String
  name                  String
  commercialName        String?
  activeIngredient      String?
  category              String?
  toxicologicalCategory String?
  safetyDataSheetUrl    String?
  safetyDataSheetName   String?
  safetyInstructions    String?
  qrCodeValue           String?
  unit                  String
  minimumStock          Decimal  @default(0)
  currentStock          Decimal  @default(0)
  expirationWarningDays Int      @default(90)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant                     Tenant                           @relation(fields: [tenantId], references: [id])
  inventoryLots              InventoryLot[]
  movements                  StockMovement[]
  purchaseItems              PurchaseItem[]
  demandForecasts            DemandForecast[]
  agrochemicalApplications   AgrochemicalApplication[]
  syncV1Contributions        SyncV1Contribution[]
  denominationAssociations   ProductCanonicalAssociation[]    @relation("ProductAssociationDenomination")
  canonicalAssociations      ProductCanonicalAssociation[]    @relation("ProductAssociationCanonical")
  collectiveReleases         CollectiveRelease[]
  jointPurchaseProposalLines JointPurchaseProposalLine[]
  collectiveSealEntries      CollectiveSealEntry[]
  consumptionSeries          ConsumptionSeries[]
  estimationResults          EstimationResult[]
  identificationRequests     ProductIdentificationRequest[]   @relation("ProductIdentificationProduct")
  identificationEvents       ProductIdentificationEvent[]     @relation("ProductIdentificationEventProduct")
  jointPurchaseCallProducts  JointPurchaseCallProduct[]
  jointPurchaseLines         JointPurchaseParticipationLine[]
  jointPurchaseClosingLines  JointPurchaseCallClosingLine[]

  @@unique([tenantId, name])
  @@unique([tenantId, qrCodeValue])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  purchases Purchase[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model AgriculturalCampaign {
  id               String         @id @default(uuid())
  tenantId         String
  name             String
  status           CampaignStatus @default(PLANIFICADA)
  isActive         Boolean        @default(false)
  startDate        DateTime
  estimatedEndDate DateTime?
  closedAt         DateTime?
  createdById      String?
  closedById       String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant                   Tenant                         @relation(fields: [tenantId], references: [id])
  createdBy                User?                          @relation("CampaignCreator", fields: [createdById], references: [id])
  closedBy                 User?                          @relation("CampaignCloser", fields: [closedById], references: [id])
  plotCropAssignments      PlotCropAssignment[]
  inventoryLots            InventoryLot[]
  stockMovements           StockMovement[]
  purchases                Purchase[]
  payableAccounts          PayableAccount[]
  payments                 Payment[]
  syncOperations           SyncOperation[]
  agrochemicalApplications AgrochemicalApplication[]
  calendarEvents           CalendarEvent[]
  auditLogs                AuditLog[]
  syncV1Contributions      SyncV1Contribution[]
  collectiveReleases       CollectiveRelease[]
  jointPurchaseProposals   JointPurchaseProposal[]
  collectiveSeals          CollectiveSeal[]
  seriesPoints             SeriesPoint[]
  estimationRuns           EstimationRun[]
  seasonClassifications    CampaignSeasonClassification[]
  estimationJobs           EstimationJob[]
  jointPurchaseCalls       JointPurchaseCall[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, isActive])
}

model Plot {
  id          String     @id @default(uuid())
  tenantId    String
  ownerUserId String
  name        String
  location    String?
  area        Decimal?
  areaUnit    String     @default("ha")
  status      PlotStatus @default(ACTIVA)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  owner                    User                      @relation(fields: [ownerUserId], references: [id])
  cropAssignments          PlotCropAssignment[]
  stockMovements           StockMovement[]
  agrochemicalApplications AgrochemicalApplication[]

  @@unique([tenantId, ownerUserId, name])
  @@index([tenantId, ownerUserId, status])
}

model Crop {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  variety   String?
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  cropAssignments          PlotCropAssignment[]
  stockMovements           StockMovement[]
  agrochemicalApplications AgrochemicalApplication[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model PlotCropAssignment {
  id          String               @id @default(uuid())
  tenantId    String
  campaignId  String
  plotId      String
  cropId      String
  ownerUserId String
  status      CropAssignmentStatus @default(ACTIVO)
  plantedArea Decimal?
  plantedAt   DateTime?
  changedAt   DateTime?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  campaign                 AgriculturalCampaign      @relation(fields: [campaignId], references: [id])
  plot                     Plot                      @relation(fields: [plotId], references: [id])
  crop                     Crop                      @relation(fields: [cropId], references: [id])
  owner                    User                      @relation(fields: [ownerUserId], references: [id])
  agrochemicalApplications AgrochemicalApplication[]

  @@unique([campaignId, plotId])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, campaignId])
  @@index([plotId, cropId])
}

model Warehouse {
  id          String   @id @default(uuid())
  tenantId    String
  ownerUserId String?
  name        String
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  owner     User?           @relation(fields: [ownerUserId], references: [id])
  lots      InventoryLot[]
  movements StockMovement[]

  @@index([tenantId])
  @@index([ownerUserId])
}

model InventoryLot {
  id              String             @id @default(uuid())
  tenantId        String
  ownerUserId     String
  campaignId      String?
  productId       String
  warehouseId     String?
  purchaseItemId  String?
  lotNumber       String?
  expirationDate  DateTime?
  initialQuantity Decimal
  currentQuantity Decimal
  unitCost        Decimal?
  status          InventoryLotStatus @default(DISPONIBLE)
  qrCodeValue     String?
  receivedAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  owner                    User                      @relation(fields: [ownerUserId], references: [id])
  campaign                 AgriculturalCampaign?     @relation(fields: [campaignId], references: [id])
  product                  Product                   @relation(fields: [productId], references: [id])
  warehouse                Warehouse?                @relation(fields: [warehouseId], references: [id])
  purchaseItem             PurchaseItem?             @relation(fields: [purchaseItemId], references: [id])
  movements                StockMovement[]
  agrochemicalApplications AgrochemicalApplication[]

  @@unique([tenantId, qrCodeValue])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, campaignId])
  @@index([productId])
  @@index([expirationDate])
}

model StockMovement {
  id             String                   @id @default(uuid())
  tenantId       String
  ownerUserId    String
  campaignId     String?
  productId      String
  inventoryLotId String?
  warehouseId    String?
  plotId         String?
  cropId         String?
  applicationId  String?
  userId         String?
  type           StockMovementType
  reasonType     StockMovementReasonType?
  quantity       Decimal
  reason         String?
  occurredAt     DateTime                 @default(now())
  createdAt      DateTime                 @default(now())

  tenant       Tenant                   @relation(fields: [tenantId], references: [id])
  owner        User                     @relation("StockMovementOwner", fields: [ownerUserId], references: [id])
  campaign     AgriculturalCampaign?    @relation(fields: [campaignId], references: [id])
  product      Product                  @relation(fields: [productId], references: [id])
  inventoryLot InventoryLot?            @relation(fields: [inventoryLotId], references: [id])
  warehouse    Warehouse?               @relation(fields: [warehouseId], references: [id])
  plot         Plot?                    @relation(fields: [plotId], references: [id])
  crop         Crop?                    @relation(fields: [cropId], references: [id])
  application  AgrochemicalApplication? @relation(fields: [applicationId], references: [id])
  user         User?                    @relation("StockMovementActor", fields: [userId], references: [id])

  @@index([tenantId, ownerUserId, occurredAt])
  @@index([tenantId, campaignId])
  @@index([productId])
  @@index([inventoryLotId])
  @@index([plotId])
  @@index([applicationId])
}

model AgrochemicalApplication {
  id                   String                        @id @default(uuid())
  tenantId             String
  campaignId           String
  ownerUserId          String
  appliedById          String?
  plotId               String
  cropId               String
  plotCropAssignmentId String?
  productId            String
  inventoryLotId       String?
  quantity             Decimal
  dose                 String?
  targetPest           String?
  weatherConditions    String?
  responsibleName      String?
  notes                String?
  status               AgrochemicalApplicationStatus @default(REGISTRADA)
  appliedAt            DateTime                      @default(now())
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  campaign           AgriculturalCampaign @relation(fields: [campaignId], references: [id])
  owner              User                 @relation("AgrochemicalApplicationOwner", fields: [ownerUserId], references: [id])
  appliedBy          User?                @relation("AgrochemicalApplicationAppliedBy", fields: [appliedById], references: [id])
  plot               Plot                 @relation(fields: [plotId], references: [id])
  crop               Crop                 @relation(fields: [cropId], references: [id])
  plotCropAssignment PlotCropAssignment?  @relation(fields: [plotCropAssignmentId], references: [id])
  product            Product              @relation(fields: [productId], references: [id])
  inventoryLot       InventoryLot?        @relation(fields: [inventoryLotId], references: [id])
  movements          StockMovement[]

  @@index([tenantId, ownerUserId, appliedAt])
  @@index([tenantId, campaignId])
  @@index([plotId, cropId])
  @@index([productId])
  @@index([inventoryLotId])
}

model Purchase {
  id             String              @id @default(uuid())
  tenantId       String
  campaignId     String?
  supplierId     String
  createdById    String?
  type           PurchaseType        @default(INDIVIDUAL)
  paymentMode    PurchasePaymentMode @default(CONTADO)
  status         PurchaseStatus      @default(BORRADOR)
  purchasedAt    DateTime            @default(now())
  expectedAt     DateTime?
  receivedAt     DateTime?
  totalAmount    Decimal             @default(0)
  discountAmount Decimal             @default(0)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  campaign     AgriculturalCampaign? @relation(fields: [campaignId], references: [id])
  supplier     Supplier              @relation(fields: [supplierId], references: [id])
  createdBy    User?                 @relation(fields: [createdById], references: [id])
  items        PurchaseItem[]
  participants PurchaseParticipant[]
  payables     PayableAccount[]

  @@index([tenantId, type, status])
  @@index([tenantId, campaignId])
  @@index([supplierId])
}

model PurchaseItem {
  id             String  @id @default(uuid())
  tenantId       String
  purchaseId     String
  productId      String
  quantity       Decimal
  unitCost       Decimal
  discountAmount Decimal @default(0)
  subtotal       Decimal

  tenant        Tenant                   @relation(fields: [tenantId], references: [id])
  purchase      Purchase                 @relation(fields: [purchaseId], references: [id])
  product       Product                  @relation(fields: [productId], references: [id])
  inventoryLots InventoryLot[]
  allocations   PurchaseItemAllocation[]

  @@index([tenantId, purchaseId])
  @@index([productId])
}

model PurchaseItemAllocation {
  id             String   @id @default(uuid())
  tenantId       String
  purchaseItemId String
  userId         String
  quantity       Decimal
  subtotal       Decimal
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  purchaseItem PurchaseItem @relation(fields: [purchaseItemId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([purchaseItemId, userId])
  @@index([tenantId, userId])
}

model PurchaseParticipant {
  id              String                    @id @default(uuid())
  tenantId        String
  purchaseId      String
  userId          String
  status          PurchaseParticipantStatus @default(PENDIENTE)
  requestedAmount Decimal                   @default(0)
  allocatedAmount Decimal                   @default(0)
  notes           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  purchase Purchase @relation(fields: [purchaseId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([purchaseId, userId])
  @@index([tenantId, userId])
}

model PayableAccount {
  id                String        @id @default(uuid())
  tenantId          String
  campaignId        String?
  purchaseId        String
  responsibleUserId String?
  dueDate           DateTime
  totalAmount       Decimal
  paidAmount        Decimal       @default(0)
  status            PayableStatus @default(PENDIENTE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  campaign        AgriculturalCampaign? @relation(fields: [campaignId], references: [id])
  purchase        Purchase              @relation(fields: [purchaseId], references: [id])
  responsibleUser User?                 @relation(fields: [responsibleUserId], references: [id])
  payments        Payment[]

  @@index([tenantId, status, dueDate])
  @@index([tenantId, campaignId])
  @@index([purchaseId])
  @@index([responsibleUserId])
}

model Payment {
  id               String   @id @default(uuid())
  tenantId         String
  campaignId       String?
  payableAccountId String
  registeredById   String?
  amount           Decimal
  paidAt           DateTime @default(now())
  notes            String?

  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  campaign       AgriculturalCampaign? @relation(fields: [campaignId], references: [id])
  payableAccount PayableAccount        @relation(fields: [payableAccountId], references: [id])
  registeredBy   User?                 @relation("PaymentRegistrar", fields: [registeredById], references: [id])

  @@index([tenantId, paidAt])
  @@index([tenantId, campaignId])
  @@index([payableAccountId])
}

model SyncOperation {
  id           String              @id @default(uuid())
  tenantId     String
  campaignId   String?
  userId       String?
  clientId     String
  entityName   String
  entityId     String?
  operation    String
  payload      Json
  status       SyncOperationStatus @default(PENDIENTE)
  errorMessage String?
  createdAt    DateTime            @default(now())
  appliedAt    DateTime?

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  campaign  AgriculturalCampaign? @relation(fields: [campaignId], references: [id])
  user      User?                 @relation(fields: [userId], references: [id])
  conflicts SyncConflict[]

  @@unique([tenantId, userId, clientId, entityId])
  @@index([tenantId, clientId, status])
  @@index([tenantId, campaignId])
  @@index([entityName, entityId])
}

model CalendarEvent {
  id              String              @id @default(uuid())
  tenantId        String
  campaignId      String?
  ownerUserId     String?
  type            CalendarEventType
  status          CalendarEventStatus @default(PENDIENTE)
  title           String
  description     String?
  eventDate       DateTime
  sourceEntity    String?
  sourceEntityId  String?
  isAutoGenerated Boolean             @default(true)
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  campaign AgriculturalCampaign? @relation(fields: [campaignId], references: [id])
  owner    User?                 @relation(fields: [ownerUserId], references: [id])

  @@index([tenantId, eventDate])
  @@index([tenantId, ownerUserId, eventDate])
  @@index([tenantId, campaignId, type])
  @@index([sourceEntity, sourceEntityId])
}

model AuditLog {
  id          String      @id @default(uuid())
  tenantId    String
  campaignId  String?
  actorUserId String?
  ownerUserId String?
  action      AuditAction
  entityName  String
  entityId    String?
  summary     String?
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  campaign AgriculturalCampaign? @relation(fields: [campaignId], references: [id])
  actor    User?                 @relation("AuditActor", fields: [actorUserId], references: [id])
  owner    User?                 @relation("AuditOwner", fields: [ownerUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, campaignId])
  @@index([tenantId, actorUserId])
  @@index([tenantId, ownerUserId])
  @@index([entityName, entityId])
}

// Parallel technical journal; no controller/module registration or business payload.
model SyncV1OperationJournal {
  id                            String                @id @default(uuid()) @db.Uuid
  tenantId                      String
  memberId                      String
  operationId                   String                @db.Uuid
  contractVersion               Int                   @default(1)
  projectionType                SyncV1ProjectionType
  action                        SyncV1Action
  predecessorOperationId        String?               @db.Uuid
  causalReconciliationReference String?               @db.Uuid
  reconciliationReference       String?               @db.Uuid
  fingerprint                   Bytes                 @db.ByteA
  fingerprintKeyVersion         Int
  processingState               SyncV1ProcessingState @default(PROCESSING)
  outcome                       SyncV1Outcome?
  disposition                   SyncV1Disposition?
  resultCode                    String?               @db.VarChar(40)
  serverAcceptedAt              DateTime?
  // F05-SYNC-05: contribution resolved for this intention (null if its refs did
  // not resolve) and its order among the contribution's accepted transitions.
  contributionId                String?               @db.Uuid
  contributionSequence          Int?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member       Member              @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  contribution SyncV1Contribution? @relation(fields: [contributionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, memberId, operationId])
  // Scoped internal processing lookup; no global operationId index/list endpoint.
  @@index([tenantId, memberId, processingState])
  @@index([contributionId, contributionSequence])
}

// F05-SYNC-05 R_CURRENT: one current value per (tenant, Member, type, campaign,
// product, unit). No history of quantities; transitions live in the journal.
model SyncV1Contribution {
  id                      String                   @id @default(uuid()) @db.Uuid
  tenantId                String
  memberId                String
  projectionType          SyncV1ProjectionType
  campaignId              String
  productId               String
  baseUnit                SyncV1BaseUnit
  status                  SyncV1ContributionStatus @default(NEVER_PUBLISHED)
  headOperationId         String?                  @db.Uuid
  quantityBase            BigInt?
  // Opaque reference of the open dispute (SyncV1Dispute.id), null if none.
  reconciliationReference String?                  @db.Uuid
  lastSequence            Int                      @default(0)
  // Accepted transitions with sequence <= this value are fenced by a resolution.
  fencedThroughSequence   Int                      @default(0)
  acceptedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member       Member                   @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  campaign     AgriculturalCampaign     @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product      Product                  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  journals     SyncV1OperationJournal[]
  disputes     SyncV1Dispute[]
  releaseItems CollectiveReleaseItem[]

  @@unique([tenantId, memberId, projectionType, campaignId, productId, baseUnit])
  @@index([tenantId, projectionType, campaignId, productId, status])
}

// F05-SYNC-05 minimal conflict record: no quantities, names, snapshots or bodies.
model SyncV1Dispute {
  id                    String                    @id @db.Uuid
  contributionId        String                    @db.Uuid
  openedByOperationId   String                    @db.Uuid
  createdAt             DateTime                  @default(now())
  closedAt              DateTime?
  closeReason           SyncV1DisputeCloseReason?
  resolvedByOperationId String?                   @db.Uuid

  contribution SyncV1Contribution @relation(fields: [contributionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([contributionId, closedAt])
}

model SyncConflict {
  id              String    @id @default(uuid())
  syncOperationId String
  serverSnapshot  Json
  clientSnapshot  Json
  resolvedPayload Json?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  syncOperation SyncOperation @relation(fields: [syncOperationId], references: [id])
}

model DemandForecast {
  id              String   @id @default(uuid())
  tenantId        String
  productId       String
  campaignName    String
  predictedDemand Decimal
  confidence      Decimal?
  generatedAt     DateTime @default(now())
  metadata        Json?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId, productId, generatedAt])
}

/// F07-REC-01 (#108) y F06 #21: asociación explícita de una denominación del
/// catálogo central con su producto canónico, confirmada por la Directiva (o
/// por el ADMINISTRADOR del tenant, RU-18). El historial es inmutable:
/// corregir cierra la vigente (`validTo`) y abre otra; nunca se borra ni se
/// renombra el producto. Sin asociación vigente, el producto es su propio
/// canónico. Una sola vigente por producto (índice único parcial en la
/// migración); nunca entre dimensiones distintas (L/KG).
model ProductCanonicalAssociation {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String
  productId          String
  canonicalProductId String
  validFrom          DateTime  @default(now())
  validTo            DateTime?
  actorUserId        String
  reason             String    @db.VarChar(280)
  closedByUserId     String?
  closeReason        String?   @db.VarChar(280)

  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product          Product @relation("ProductAssociationDenomination", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canonicalProduct Product @relation("ProductAssociationCanonical", fields: [canonicalProductId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor            User    @relation("ProductAssociationActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  closedBy         User?   @relation("ProductAssociationCloser", fields: [closedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, productId, validTo])
  @@index([tenantId, canonicalProductId, validTo])
}

/// F06 #21 con la política provisional F07-POL-01 (#107): última divulgación
/// de una celda (campaña × producto canónico × tipo × unidad base) y las
/// contribuciones que la componen. Sólo se escribe en modo de divulgación
/// provisional; no guarda cantidades por agricultor.
model CollectiveRelease {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String
  campaignId         String
  canonicalProductId String
  projectionType     SyncV1ProjectionType
  baseUnit           SyncV1BaseUnit
  totalBase          BigInt
  contributorCount   Int
  dataAsOf           DateTime?
  releasedAt         DateTime             @default(now())
  withdrawnAt        DateTime?

  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign         AgriculturalCampaign        @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canonicalProduct Product                     @relation(fields: [canonicalProductId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items            CollectiveReleaseItem[]
  proposalLines    JointPurchaseProposalLine[]
  sealEntries      CollectiveSealEntry[]
  seriesPoints     SeriesPoint[]

  @@index([tenantId, campaignId, canonicalProductId, projectionType, baseUnit, releasedAt])
}

/// Contribución incluida en una divulgación y la secuencia que tenía entonces.
model CollectiveReleaseItem {
  releaseId      String  @db.Uuid
  contributionId String  @db.Uuid
  sequence       Int
  /// Cantidad del aporte en esa divulgación (F10-SEC-02 #45). NULL en filas
  /// anteriores a la revisión: desconocida; no prueba un cambio ni su ausencia.
  quantityBase   BigInt?

  release      CollectiveRelease  @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contribution SyncV1Contribution @relation(fields: [contributionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([releaseId, contributionId])
}

/// F08-BKP-01/02 (#37, #38): metadata of a farmer's private backup. The binary
/// lives in a separate private storage adapter under `storageKey`, never in
/// PostgreSQL. Owner = authenticated Member of the tenant. Not part of Sync v1
/// nor of any collective projection (F06 §8); no file name from the client.
model BackupMetadata {
  id             String       @id @db.Uuid
  tenantId       String
  memberId       String
  status         BackupStatus @default(UPLOADING)
  /// Generated by the server; never derived from client input.
  storageKey     String       @unique @db.Uuid
  contentType    String       @db.VarChar(64)
  /// Compatibility declared by the client (container format, SQLite schema).
  formatVersion  Int
  schemaVersion  Int
  /// SHA-256 declared by the client; equals the server-computed hash when AVAILABLE.
  sha256         String       @db.Char(64)
  /// Server-measured size; set only when AVAILABLE.
  sizeBytes      BigInt?
  /// Closed code of a FAILED upload (no request content).
  failureCode    String?      @db.VarChar(48)
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
  deletedAt      DateTime?
  /// F08-BKP-06 (#40): DELETED or FAILED row whose bytes the storage has not
  /// yet confirmed as gone. A CHECK keeps it false on any other status.
  purgePending   Boolean      @default(false)
  /// OWNER or RETENTION, only on DELETED rows (CHECK in the migration).
  deletionReason String?      @db.VarChar(16)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member Member @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, memberId, status, createdAt])
}

/// F07 #27 (JP-02): borrador de propuesta de compra conjunta para revisión
/// humana. Sólo DRAFT: no ejecuta compras, ni crea lotes, movimientos, deudas
/// o pagos. Usa la necesidad declarada (no resta stock: no es necesidad neta).
enum JointPurchaseProposalStatus {
  DRAFT
}

/// Estado de una línea, el mismo que decidió el resumen colectivo.
enum JointPurchaseProposalLineStatus {
  DISCLOSED
  SUPPRESSED_UNDER_THRESHOLD
  SUPPRESSED_REVISION
  OVERFLOW
}

/// Generada desde las celdas DECLARED_NEED del resumen (F07-POL-01). Guarda la
/// cobertura agregada autorizada y la huella de sus entradas, nunca cantidades
/// por agricultor ni identidades.
model JointPurchaseProposal {
  id                      String                      @id @default(uuid()) @db.Uuid
  tenantId                String
  campaignId              String
  status                  JointPurchaseProposalStatus @default(DRAFT)
  inputsFingerprint       String                      @db.Char(64)
  linkedMembers           Int
  membersWithContribution Int
  // F10-SEC-02: rule of membersWithContribution. NULL = drafts generated
  // before the change (contributors of every cell, suppressed ones included);
  // PUBLISHED_FIGURES = Members inside a published figure. Never rewritten.
  coverageBasis           String?                     @db.VarChar(24)
  generatedAt             DateTime                    @default(now())
  generatedByUserId       String

  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign    AgriculturalCampaign        @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  generatedBy User                        @relation("JointPurchaseProposalAuthor", fields: [generatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines       JointPurchaseProposalLine[]
  calls       JointPurchaseCall[]

  @@index([tenantId, campaignId, generatedAt])
}

/// Línea por producto canónico y unidad base. No guarda la cantidad: la
/// referencia a la divulgación (CollectiveRelease) que mostró el resumen. Si
/// esa divulgación se retira, la propuesta deja de servir la cifra.
model JointPurchaseProposalLine {
  proposalId         String                          @db.Uuid
  position           Int
  canonicalProductId String
  baseUnit           SyncV1BaseUnit
  status             JointPurchaseProposalLineStatus
  releaseId          String?                         @db.Uuid
  pendingChanges     Boolean                         @default(false)

  proposal         JointPurchaseProposal      @relation(fields: [proposalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canonicalProduct Product                    @relation(fields: [canonicalProductId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  release          CollectiveRelease?         @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  callProducts     JointPurchaseCallProduct[]

  @@id([proposalId, position])
  @@unique([proposalId, canonicalProductId, baseUnit])
}

/// F07 (2026-10-23): estado de una celda en la versión sellada; el mismo que
/// decidió el resumen al sellar.
enum CollectiveSealEntryStatus {
  DISCLOSED
  SUPPRESSED_UNDER_THRESHOLD
  SUPPRESSED_REVISION
  OVERFLOW
}

/// F07 (2026-10-23, `F07_SEALED_HISTORY_CONTRACT.md`): versión sellada del
/// consolidado de una campaña CERRADA, fijada a mano por DIRECTIVA o
/// ADMINISTRADOR del tenant (R_COLLECTIVE_HISTORY, contrato F06 §7.2). Guarda
/// el actor, la hora del servidor, la política aplicada y la cobertura
/// agregada; ninguna cantidad por aportación ni identidad de agricultor.
/// Inmutable (disparadores de la migración); este bloque sólo admite la
/// versión 1.
model CollectiveSeal {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String
  campaignId              String
  version                 Int      @default(1)
  sealedAt                DateTime
  sealedByUserId          String
  sealedByRole            UserRole
  disclosureMode          String   @db.VarChar(32)
  policy                  String   @db.VarChar(16)
  threshold               Int
  linkedMembers           Int
  membersWithContribution Int
  suppressedCells         Boolean
  openDisputes            Boolean
  reviewRef               String   @db.Char(64)

  tenant              Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign            AgriculturalCampaign               @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sealedBy            User                               @relation("CollectiveSealActor", fields: [sealedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entries             CollectiveSealEntry[]
  seriesPoints        SeriesPoint[]
  consumptionCoverage CollectiveSealConsumptionCoverage?

  @@unique([tenantId, campaignId, version])
}

/// Una celda de la versión sellada. La cifra sale de la divulgación
/// referenciada (inmutable); aquí no se copia. `visibilityWithdrawnAt` sólo
/// pasa de NULL a una fecha cuando el aportante retira (CANCEL) una aportación
/// de esa divulgación después del sellado: el dato sellado no cambia.
model CollectiveSealEntry {
  sealId                String                    @db.Uuid
  projectionType        SyncV1ProjectionType
  canonicalProductId    String
  baseUnit              SyncV1BaseUnit
  status                CollectiveSealEntryStatus
  releaseId             String?                   @db.Uuid
  pendingChanges        Boolean                   @default(false)
  visibilityWithdrawnAt DateTime?

  seal             CollectiveSeal     @relation(fields: [sealId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canonicalProduct Product            @relation(fields: [canonicalProductId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  release          CollectiveRelease? @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([sealId, projectionType, canonicalProductId, baseUnit])
  @@index([releaseId])
}

/// F07 §5.3 (2026-11-02, para F12): estado de la cobertura del consumo de un
/// sellado. POPULATION_MISMATCH: algún Member de una cifra de consumo mostrada
/// no estaba entre los vinculados leídos; no se registra ninguna fracción.
enum ConsumptionCoverageStatus {
  IDENTIFIED
  POPULATION_MISMATCH
}

/// F07 §5.3 (2026-11-02, para F12): cobertura de participación del consumo de
/// un sellado nuevo, escrita en la misma transacción que el sellado e
/// inmutable. N = Members distintos con un aporte dentro de alguna cifra de
/// CONSUMPTION_TOTAL mostrada al sellar; M = Members AGRICULTOR activos con
/// cuenta activa leídos en esa decisión (igual a `CollectiveSeal.linkedMembers`).
/// Mide participación, no integridad del consumo. Los sellados anteriores no
/// tienen fila: su cobertura de consumo es desconocida y no se reconstruye.
model CollectiveSealConsumptionCoverage {
  sealId                    String                    @id @db.Uuid
  status                    ConsumptionCoverageStatus
  linkedMembers             Int?
  membersInPublishedFigures Int?

  seal CollectiveSeal @relation(fields: [sealId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

/// F12-EST-01 (#174, `F12_EST_01_ESTIMATION_CONTRACT.md`): clase de una
/// posición de la serie de consumo (RN-26, DAT-18). Un cero comprobado es
/// VERIFIED_CONSUMPTION con cantidad 0; NO_RECORD y HIDDEN no llevan cantidad
/// y nunca se tratan como cero.
enum SeriesPointKind {
  VERIFIED_CONSUMPTION
  NO_RECORD
  HIDDEN
}

/// F12-EST-01: resultado de una ejecución de estimación, registrado una vez.
enum EstimationRunOutcome {
  CALCULATED
  FAILED
}

/// F12-EST-01: estado de un producto dentro de una ejecución. Sólo ESTIMATED
/// lleva cifras; los demás informan la condición sin cifras (RN-28).
enum EstimationResultStatus {
  ESTIMATED
  INSUFFICIENT_DATA
  INCOMPATIBLE_DATA
  CALCULATION_FAILED
}

/// F12-EST-01 (EST-D-02): temporada institucional que define qué campañas son
/// comparables. La crea DIRECTIVA o ADMINISTRADOR (ADR-003) con una clave
/// explícita, su definición y su duración nominal; nunca se infiere de nombres
/// ni de fechas. Inmutable: otra definición es otra temporada con otra clave.
model ComparabilitySeason {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String
  /// Clave de comparabilidad asignada por la Directiva.
  key             String   @db.VarChar(64)
  definition      String   @db.VarChar(500)
  /// Duración nominal de una campaña de la temporada, en días.
  durationDays    Int
  createdByUserId String
  createdByRole   UserRole
  createdAt       DateTime @default(now())

  tenant          Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User                           @relation("ComparabilitySeasonCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  classifications CampaignSeasonClassification[]
  series          ConsumptionSeries[]
  runs            EstimationRun[]

  @@unique([tenantId, key])
}

/// F12-EST-01 (EST-D-02, EST-D-14): versión de la clasificación explícita de
/// una campaña en una temporada, hecha por DIRECTIVA o ADMINISTRADOR. La
/// versión 1 asigna una temporada; una corrección es la versión siguiente, con
/// motivo, y puede dejar la campaña sin clasificar (`seasonId` nulo). La
/// vigente es la que no tiene sucesora. Una campaña sin filas está sin
/// clasificar. No se rellena para campañas antiguas ni toca sus sellados.
/// Inmutable: las series y ejecuciones conservan la versión que usaron.
model CampaignSeasonClassification {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String
  campaignId               String
  version                  Int
  previousClassificationId String?  @db.Uuid
  seasonId                 String?  @db.Uuid
  reason                   String?  @db.VarChar(500)
  classifiedByUserId       String
  classifiedByRole         UserRole
  classifiedAt             DateTime @default(now())

  campaign               AgriculturalCampaign          @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant                 Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  season                 ComparabilitySeason?          @relation(fields: [seasonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  classifiedBy           User                          @relation("CampaignSeasonClassifier", fields: [classifiedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousClassification CampaignSeasonClassification? @relation("CampaignSeasonCorrection", fields: [previousClassificationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nextClassification     CampaignSeasonClassification? @relation("CampaignSeasonCorrection")
  seriesPoints           SeriesPoint[]
  runs                   EstimationRun[]

  @@unique([campaignId, version])
  @@unique([previousClassificationId])
  @@index([tenantId, seasonId])
}

/// F12-EST-01 (consumption_series): serie de consumo autorizado por producto
/// canónico, unidad base y temporada, derivada sólo de cifras publicadas y
/// selladas. Se escribe una vez; si cambian las cifras, las asociaciones o las
/// clasificaciones se crea una versión nueva y la anterior se conserva con sus
/// ejecuciones. Inmutable (disparadores de la migración). Sin cantidades por
/// agricultor.
model ConsumptionSeries {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String
  canonicalProductId String
  baseUnit           SyncV1BaseUnit
  seasonId           String         @db.Uuid
  version            Int
  previousSeriesId   String?        @db.Uuid
  /// SHA-256 en hexadecimal de las fuentes y sus versiones (§5 del contrato).
  sourceHash         String         @db.Char(64)
  sources            Json
  builtAt            DateTime       @default(now())

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canonicalProduct Product             @relation(fields: [canonicalProductId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  season           ComparabilitySeason @relation(fields: [seasonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousSeries   ConsumptionSeries?  @relation("ConsumptionSeriesVersion", fields: [previousSeriesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nextSeries       ConsumptionSeries?  @relation("ConsumptionSeriesVersion")
  points           SeriesPoint[]
  results          EstimationResult[]

  @@unique([tenantId, canonicalProductId, baseUnit, seasonId, version], map: "ConsumptionSeries_scope_version_key")
  @@unique([previousSeriesId])
}

/// F12-EST-01 (series_point): una campaña clasificada en la temporada de la
/// serie, con la versión de la clasificación usada, en orden cronológico. La cantidad existe exactamente cuando es
/// consumo comprobado, que exige una campaña cerrada y su versión sellada
/// (EST-D-03). Sin columnas de cobertura: no hay una fuente verificable de la
/// cobertura del consumo (EST-D-09).
model SeriesPoint {
  seriesId         String          @db.Uuid
  position         Int
  campaignId       String
  /// Versión vigente de la clasificación al construir la serie (EST-D-14).
  classificationId String          @db.Uuid
  kind             SeriesPointKind
  quantityBase     BigInt?
  sourceSealId     String?         @db.Uuid
  sourceReleaseId  String?         @db.Uuid

  series         ConsumptionSeries            @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign       AgriculturalCampaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  classification CampaignSeasonClassification @relation(fields: [classificationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceSeal     CollectiveSeal?              @relation(fields: [sourceSealId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceRelease  CollectiveRelease?           @relation(fields: [sourceReleaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([seriesId, position])
  @@unique([seriesId, campaignId])
  @@index([sourceReleaseId])
}

/// F12-EST-01 (EST-D-04): estado operativo de un trabajo de estimación.
enum EstimationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  NOT_EXECUTED
}

/// F12-EST-01 (EST-D-04): solicitud de cálculo por lotes, fuera de la petición
/// interactiva. Es estado operativo y es lo único que cambia: identidad,
/// petición y campaña objetivo no cambian; QUEUED → RUNNING → COMPLETED o
/// NOT_EXECUTED, y un estado final no cambia. No se borra. La ejecución que
/// produce (EstimationRun) se escribe una vez y no cambia.
model EstimationJob {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String
  requestId         String              @db.Uuid
  /// SHA-256 de la petición canónica (campaña objetivo y productos pedidos):
  /// el mismo `requestId` con otra huella es REQUEST_ID_REUSED.
  requestHash       String              @db.Char(64)
  requestedByUserId String
  requestedByRole   UserRole
  targetCampaignId  String
  /// Productos canónicos pedidos; NULL = los productos canónicos estimables
  /// con consumo publicado en la temporada de la campaña objetivo.
  productRefs       Json?
  status            EstimationJobStatus @default(QUEUED)
  attempts          Int                 @default(0)
  /// Máximo de intentos configurado al encolar; sólo los errores transitorios
  /// consumen un intento nuevo (EST-D-16).
  maxAttempts       Int
  enqueuedAt        DateTime            @default(now())
  startedAt         DateTime?
  leaseExpiresAt    DateTime?
  finishedAt        DateTime?
  /// NOT_EXECUTED: motivo cerrado y lo observado al comprobarlo, antes de
  /// calcular (EST-D-15).
  stopCode          String?             @db.VarChar(48)
  stopEvidence      Json?

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy    User                 @relation("EstimationJobRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetCampaign AgriculturalCampaign @relation(fields: [targetCampaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  run            EstimationRun?

  @@unique([tenantId, requestId])
  @@index([status, enqueuedAt])
}

/// F12-EST-01 (estimation_run): la ejecución de un trabajo de estimación de
/// DIRECTIVA o ADMINISTRADOR (ADR-003) para una campaña objetivo, con método,
/// parámetros, política de divulgación aplicada y resultado (calculada o
/// fallida), registrado una vez. Referencia a la ejecución anterior sin
/// modificarla. Sin columna de vigencia (se deriva al consultar) ni campos de
/// aprobación. Una sola cadena por campaña objetivo: índice único parcial de la
/// migración (una sola ejecución sin anterior por tenant y campaña objetivo).
model EstimationRun {
  id                     String               @id @default(uuid()) @db.Uuid
  tenantId               String
  jobId                  String               @unique @db.Uuid
  /// Intento del trabajo que la produjo; la base exige el vigente y, salvo
  /// RETRIES_EXHAUSTED, el plazo sin vencer (F12-EST-05, titularidad).
  jobAttempt             Int?
  requestedByUserId      String
  requestedByRole        UserRole
  targetCampaignId       String
  seasonId               String               @db.Uuid
  /// Versión vigente de la clasificación de la campaña objetivo al registrar.
  targetClassificationId String               @db.Uuid
  contractVersion        Int
  method                 String               @db.VarChar(32)
  methodVersion          String               @db.VarChar(32)
  parameters             Json
  horizon                Int
  disclosureMode         String               @db.VarChar(32)
  policy                 String               @db.VarChar(16)
  threshold              Int
  outcome                EstimationRunOutcome
  failureCode            String?              @db.VarChar(48)
  previousRunId          String?              @db.Uuid
  contentHash            String               @db.Char(64)
  generatedAt            DateTime             @default(now())

  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  job                  EstimationJob                @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy          User                         @relation("EstimationRunRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetCampaign       AgriculturalCampaign         @relation(fields: [targetCampaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  season               ComparabilitySeason          @relation(fields: [seasonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetClassification CampaignSeasonClassification @relation(fields: [targetClassificationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousRun          EstimationRun?               @relation("EstimationRunSuccession", fields: [previousRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nextRun              EstimationRun?               @relation("EstimationRunSuccession")
  results              EstimationResult[]

  @@unique([previousRunId])
  @@index([tenantId, targetCampaignId, generatedAt])
}

/// F12-EST-01 (estimation_result): estimación SES y línea base naive de un
/// producto en una ejecución, o la condición sin cifras. Se inserta en la
/// misma transacción que su ejecución y no se modifica.
model EstimationResult {
  runId              String                 @db.Uuid
  canonicalProductId String
  baseUnit           SyncV1BaseUnit
  seriesId           String?                @db.Uuid
  status             EstimationResultStatus
  reasonCode         String?                @db.VarChar(48)
  /// Estimación SES en la unidad base (h = 1).
  estimateBase       Decimal?               @db.Decimal(30, 6)
  /// Línea base naive: el último valor comprobado del tramo.
  naiveBase          BigInt?
  alpha              Decimal?               @db.Decimal(3, 2)
  fitInformative     Boolean?
  fitCriterion       Decimal?               @db.Decimal(38, 6)
  spanFirstPosition  Int?
  spanLastPosition   Int?
  exclusions         Json
  validations        Json
  metrics            Json?

  run              EstimationRun      @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canonicalProduct Product            @relation(fields: [canonicalProductId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  series           ConsumptionSeries? @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([runId, canonicalProductId, baseUnit])
  @@index([seriesId])
}

/// E1 (etapa 1): solicitud de identificación de un producto reportado por el
/// agricultor. No es un `Product`: queda PENDING hasta que la Directiva (o el
/// Administrador del mismo tenant) lo vincula a un producto existente o crea
/// uno colectivo. El vínculo en el teléfono sigue siendo una elección del
/// agricultor (E1-D4).
enum ProductIdentificationStatus {
  PENDING
  LINKED
}

enum ProductIdentificationResolution {
  LINKED_EXISTING
  CREATED_PRODUCT
}

enum ProductIdentificationPhotoState {
  NONE
  STORED
  REMOVED
}

enum ProductIdentificationEventKind {
  RECEIVED
  UPDATED
  PHOTO_RECEIVED
  PHOTO_REPLACED
  PHOTO_REMOVED
  LINKED
  RELINKED
  PRODUCT_CREATED
  NOTE
}

/// E1 §3. Sólo metadatos de la foto: el binario vive en el almacenamiento
/// privado (E1-D8), bajo una clave UUID generada por el servidor.
model ProductIdentificationRequest {
  id                  String                           @id @default(uuid()) @db.Uuid
  tenantId            String
  memberId            String
  /// UUID v4 generado por el teléfono (idempotencia, E1-D3).
  clientRequestId     String                           @db.Uuid
  localName           String                           @db.VarChar(120)
  activeIngredient    String?                          @db.VarChar(120)
  /// "L" | "KG" (CHECK en la migración); inmutable.
  unit                String                           @db.VarChar(2)
  baseUnit            SyncV1BaseUnit
  status              ProductIdentificationStatus      @default(PENDING)
  resolution          ProductIdentificationResolution?
  productId           String?
  resolvedByUserId    String?
  resolvedAt          DateTime?
  resolutionReason    String?                          @db.VarChar(280)
  pendingNote         String?                          @db.VarChar(280)
  pendingNoteByUserId String?
  pendingNoteAt       DateTime?
  photoState          ProductIdentificationPhotoState  @default(NONE)
  photoStorageKey     String?                          @unique @db.Uuid
  photoSha256         String?                          @db.Char(64)
  photoContentType    String?                          @db.VarChar(16)
  photoSizeBytes      Int?
  photoWidth          Int?
  photoHeight         Int?
  photoConsentVersion String?                          @db.VarChar(16)
  photoConsentAt      DateTime?
  photoStoredAt       DateTime?
  photoRemovedAt      DateTime?
  receivedAt          DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  tenant        Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member        Member                       @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  product       Product?                     @relation("ProductIdentificationProduct", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy    User?                        @relation("ProductIdentificationResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pendingNoteBy User?                        @relation("ProductIdentificationNoteAuthor", fields: [pendingNoteByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  events        ProductIdentificationEvent[]

  @@unique([tenantId, memberId, clientRequestId])
  @@index([tenantId, status, receivedAt])
}

/// E1-D13: historial de una solicitud. No se borra ni se modifica (trigger en
/// la migración). `actorUserId` null = el agricultor, que nunca se nombra.
model ProductIdentificationEvent {
  id          String                         @id @default(uuid()) @db.Uuid
  requestId   String                         @db.Uuid
  at          DateTime                       @default(now())
  kind        ProductIdentificationEventKind
  actorUserId String?
  productId   String?
  /// Motivo o nota; nunca nombres de personas ni rutas de archivo.
  detail      String?                        @db.VarChar(280)

  request ProductIdentificationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor   User?                        @relation("ProductIdentificationEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product Product?                     @relation("ProductIdentificationEventProduct", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([requestId, at])
}

/// E2 (etapa 2): convocatorias de compra conjunta y participación identificada
/// (docs/architecture/E2_CONVOCATORIAS_COMPRA_CONJUNTA_CONTRATO.md §3). Una
/// participación no es una compra ni una deuda: nada aquí escribe compras,
/// cuentas, pagos, inventario ni Sync v1.
enum JointPurchaseCallStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum JointPurchaseCallEventKind {
  CREATED
  UPDATED
  OPENED
  CLOSED
  CANCELLED
  RESPONSIBLE_ASSIGNED
  /// E2-P3 (§10.2): concesión y revocación de permisos de colaboradores.
  ACCESS_GRANTED
  ACCESS_REVOKED
}

/// E2-P3 (§10.2): acción registrada en JointPurchaseCallAccessEvent.
enum JointPurchaseCallAccessAction {
  GRANTED
  REVOKED
}

enum JointPurchaseParticipationStatus {
  ACTIVE
  WITHDRAWN
}

enum JointPurchaseCallCloseMode {
  MANUAL
  AUTOMATIC
}

/// E2-D1/D2: convocatoria; nombre, fecha límite, responsable y productos no
/// cambian después de abrir (CHECK de estados coherentes en la migración).
model JointPurchaseCall {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String
  campaignId        String
  name              String                  @db.VarChar(120)
  status            JointPurchaseCallStatus @default(DRAFT)
  deadlineAt        DateTime
  responsibleUserId String
  sourceProposalId  String?                 @db.Uuid
  createdByUserId   String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  openedAt          DateTime?
  openedByUserId    String?
  closedAt          DateTime?
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelReason      String?                 @db.VarChar(280)

  tenant         Tenant                                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign       AgriculturalCampaign                  @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  responsible    User                                  @relation("JointPurchaseCallResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User                                  @relation("JointPurchaseCallCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  openedBy       User?                                 @relation("JointPurchaseCallOpener", fields: [openedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledBy    User?                                 @relation("JointPurchaseCallCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceProposal JointPurchaseProposal?                @relation(fields: [sourceProposalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  products       JointPurchaseCallProduct[]
  participations JointPurchaseParticipation[]
  operations     JointPurchaseParticipationOperation[]
  events         JointPurchaseCallEvent[]
  access         JointPurchaseCallAccess[]
  accessEvents   JointPurchaseCallAccessEvent[]
  closing        JointPurchaseCallClosing?

  @@index([tenantId, campaignId, status])
  @@index([status, deadlineAt])
}

/// Producto colectivo de la convocatoria. `openCampaignId` = `campaignId`
/// mientras la convocatoria está OPEN y NULL en otro caso: índice único parcial
/// (tenantId, openCampaignId, productId) en la migración (E2-D3).
model JointPurchaseCallProduct {
  callId           String         @db.Uuid
  position         Int
  tenantId         String
  productId        String
  baseUnit         SyncV1BaseUnit
  openCampaignId   String?
  /// Línea de origen (proposalId, position) de un borrador F07: sólo referencia.
  sourceProposalId String?        @db.Uuid
  sourcePosition   Int?

  call       JointPurchaseCall          @relation(fields: [callId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product    Product                    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceLine JointPurchaseProposalLine? @relation(fields: [sourceProposalId, sourcePosition], references: [proposalId, position], onDelete: Restrict, onUpdate: Restrict)

  @@id([callId, position])
  @@unique([callId, productId])
}

/// E2-D6 y E2-P3 (§10.2): permisos por convocatoria, `PARTICIPANTS` o
/// `MANAGE`. El sistema crea `PARTICIPANTS` para el responsable al abrir
/// (`grantedByUserId` nulo); los de colaboradores los concede el responsable.
/// Ningún rol los concede por sí solo. Revocar borra la fila; la traza queda
/// en JointPurchaseCallAccessEvent.
model JointPurchaseCallAccess {
  callId          String   @db.Uuid
  userId          String
  grant           String   @db.VarChar(16)
  grantedAt       DateTime @default(now())
  grantedByUserId String?

  call      JointPurchaseCall @relation(fields: [callId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User              @relation("JointPurchaseCallAccessHolder", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedBy User?             @relation("JointPurchaseCallAccessGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([callId, userId, grant])
}

/// E2-P3 (§10.2): registro sólo de inserción (disparador en la migración) de
/// cada concesión y revocación de un permiso de colaborador.
model JointPurchaseCallAccessEvent {
  id          String                        @id @default(uuid()) @db.Uuid
  callId      String                        @db.Uuid
  userId      String
  grant       String                        @db.VarChar(16)
  action      JointPurchaseCallAccessAction
  actorUserId String
  at          DateTime                      @default(now())

  call  JointPurchaseCall @relation(fields: [callId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user  User              @relation("JointPurchaseCallAccessEventSubject", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor User              @relation("JointPurchaseCallAccessEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([callId, at])
  @@index([callId, userId, grant])
}

/// E2-D8/D9: una participación por (convocatoria, Member), con el
/// consentimiento CONV-1 aceptado en el teléfono y recibido por el servidor.
model JointPurchaseParticipation {
  id                String                           @id @default(uuid()) @db.Uuid
  callId            String                           @db.Uuid
  tenantId          String
  memberId          String
  status            JointPurchaseParticipationStatus
  consentVersion    String                           @db.VarChar(16)
  consentAcceptedAt DateTime
  consentReceivedAt DateTime
  lastSequence      Int
  lastOperationId   String                           @db.Uuid
  acceptedAt        DateTime
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  call   JointPurchaseCall                @relation(fields: [callId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member Member                           @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lines  JointPurchaseParticipationLine[]

  @@unique([callId, memberId])
}

/// Cantidad solicitada en la unidad base del producto (entero > 0, CHECK).
model JointPurchaseParticipationLine {
  participationId String         @db.Uuid
  productId       String
  baseUnit        SyncV1BaseUnit
  quantityBase    BigInt

  participation JointPurchaseParticipation @relation(fields: [participationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product       Product                    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([participationId, productId])
}

/// E2-D10: diario de operaciones del agricultor (idempotencia y orden). Se
/// registra toda operación decidida con la convocatoria bloqueada; `response`
/// guarda la respuesta enviada para devolverla igual ante un reintento.
model JointPurchaseParticipationOperation {
  callId      String   @db.Uuid
  memberId    String
  operationId String   @db.Uuid
  sequence    Int
  kind        String   @db.VarChar(16)
  outcome     String   @db.VarChar(24)
  fingerprint String   @db.Char(64)
  response    Json
  receivedAt  DateTime @default(now())

  call   JointPurchaseCall @relation(fields: [callId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member Member            @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([callId, memberId, operationId])
  @@index([callId, memberId, outcome, sequence])
}

/// Historial de la convocatoria; sin nombres ni cantidades de agricultores. No
/// se modifica ni se borra (trigger en la migración).
model JointPurchaseCallEvent {
  id          String                     @id @default(uuid()) @db.Uuid
  callId      String                     @db.Uuid
  at          DateTime                   @default(now())
  kind        JointPurchaseCallEventKind
  actorUserId String?
  detail      String?                    @db.VarChar(280)

  call  JointPurchaseCall @relation(fields: [callId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor User?             @relation("JointPurchaseCallEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([callId, at])
}

/// E2-D13: «Consolidado al cierre», instantánea inmutable (trigger en la
/// migración para las cuatro tablas del cierre).
model JointPurchaseCallClosing {
  callId           String                     @id @db.Uuid
  mode             JointPurchaseCallCloseMode
  cutoffAt         DateTime
  closedAt         DateTime
  closedByUserId   String?
  participantCount Int

  call         JointPurchaseCall                     @relation(fields: [callId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  closedBy     User?                                 @relation("JointPurchaseCallCloser", fields: [closedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines        JointPurchaseCallClosingLine[]
  participants JointPurchaseCallClosingParticipant[]
}

model JointPurchaseCallClosingLine {
  callId            String         @db.Uuid
  productId         String
  baseUnit          SyncV1BaseUnit
  totalQuantityBase BigInt
  participantCount  Int

  closing JointPurchaseCallClosing @relation(fields: [callId], references: [callId], onDelete: Restrict, onUpdate: Restrict)
  product Product                  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([callId, productId])
}

model JointPurchaseCallClosingParticipant {
  callId          String   @db.Uuid
  participationId String   @db.Uuid
  memberId        String
  acceptedAt      DateTime

  closing JointPurchaseCallClosing                  @relation(fields: [callId], references: [callId], onDelete: Restrict, onUpdate: Restrict)
  lines   JointPurchaseCallClosingParticipantLine[]

  @@id([callId, participationId])
}

model JointPurchaseCallClosingParticipantLine {
  callId          String @db.Uuid
  participationId String @db.Uuid
  productId       String
  quantityBase    BigInt

  participant JointPurchaseCallClosingParticipant @relation(fields: [callId, participationId], references: [callId, participationId], onDelete: Restrict, onUpdate: Restrict)

  @@id([callId, participationId, productId])
}
